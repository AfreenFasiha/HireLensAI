# HireLens AI — Environment Configuration Template
PROJECT_NAME="HireLens AI"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL in production, SQLite for lightweight local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hirelens_ai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="hirelens_ai"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Security & JWT Tokens
JWT_SECRET_KEY="generate-a-strong-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://hirelens-ai.vercel.app"

# File Storage Configuration
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=".pdf,.docx"

# Frontend Vite Variables
VITE_API_BASE_URL="http://localhost:8000/api/v1"
